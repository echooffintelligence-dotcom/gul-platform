# ─── Supabase ────────────────────────────────────────────────────────────────
# URL и publishable-ключ безопасно раскрывать клиенту: они и так уходят
# в браузерный бандл. Данные защищает RLS из supabase/schema.sql,
# а не секретность этих значений.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Внешний backend (необязательно) ─────────────────────────────────────────
# Если задано, api-client шлёт запросы сюда вместо встроенных route handlers.
# Пусто — используются /api/* внутри Next.js.
NEXT_PUBLIC_API_URL=

# Тексты песен берутся из публичного lrclib.net и ключа не требуют.
